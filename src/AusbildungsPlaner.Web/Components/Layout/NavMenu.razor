<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Startseite
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavGroup Title="Planung" Icon="@Icons.Material.Filled.CalendarMonth" Expanded="true">
                <MudNavLink Href="/semester" Icon="@Icons.Material.Filled.School">
                    Semester
                </MudNavLink>
                <MudNavLink Href="/themen" Icon="@Icons.Material.Filled.Book">
                    Themen
                </MudNavLink>
            </MudNavGroup>

            <AuthorizeView Roles="Admin" Context="adminCtx">
                <Authorized>
                    <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings">
                        <MudNavLink Href="/admin/benutzer" Icon="@Icons.Material.Filled.People">
                            Benutzer
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/account/login" Icon="@Icons.Material.Filled.Login">
                Anmelden
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

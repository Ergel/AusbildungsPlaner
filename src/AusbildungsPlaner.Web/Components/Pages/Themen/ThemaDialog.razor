@inject ThemaService ThemaService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="Thema.Titel" Label="Titel" Required="true"
                          RequiredError="Titel ist erforderlich." Class="mb-3" />

            <MudTextField @bind-Value="Thema.Kategorie" Label="Kategorie" Required="true"
                          RequiredError="Kategorie ist erforderlich." Class="mb-3"
                          HelperText='z.B. "Datenbanken", "OOP", "Testing"' />

            <MudTextField @bind-Value="Thema.Beschreibung" Label="Beschreibung"
                          Lines="3" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Abbrechen">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Speichern" Disabled="!_valid">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Thema Thema { get; set; } = new();

    private MudForm _form = null!;
    private bool _valid;

    protected override void OnInitialized()
    {
        // Kopie erstellen damit Abbrechen keine Änderungen behält
        Thema = new Thema
        {
            Id = Thema.Id,
            Titel = Thema.Titel,
            Kategorie = Thema.Kategorie,
            Beschreibung = Thema.Beschreibung
        };
    }

    private async Task Speichern()
    {
        await _form.ValidateAsync();
        if (_valid)
            MudDialog.Close(DialogResult.Ok(Thema));
    }

    private void Abbrechen() => MudDialog.Cancel();
}
